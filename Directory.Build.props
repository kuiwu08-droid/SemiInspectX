<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <Target Name="CopyNativeEngine" AfterTargets="Build" Condition="Exists('$(MSBuildThisFileDirectory)build/native/Release/semiinspect.dll')">
    <ItemGroup><NativeRuntime Include="$(MSBuildThisFileDirectory)build/native/Release/*.dll" /></ItemGroup>
    <Copy SourceFiles="@(NativeRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
