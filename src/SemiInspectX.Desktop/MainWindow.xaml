<Window x:Class="SemiInspectX.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SemiInspectX.Desktop"
        Title="SemiInspectX" Width="1420" Height="940" MinWidth="1200" MinHeight="800" Background="#0D1422" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="220"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,18">
      <StackPanel><TextBlock Text="SEMIINSPECT X" FontSize="26" FontWeight="Bold" Foreground="#61E1C1"/><TextBlock Text="SEMICONDUCTOR INSPECTION · METROLOGY · EQUIPMENT AUTOMATION" FontSize="11" Foreground="#849CB7" Margin="0,5,0,0"/></StackPanel>
      <StackPanel HorizontalAlignment="Right"><TextBlock Text="SIMULATION WORKSTATION / 01" Foreground="#849CB7" HorizontalAlignment="Right"/><TextBlock Text="{Binding State}" FontSize="22" FontWeight="SemiBold" Foreground="#61E1C1" HorizontalAlignment="Right" Margin="0,4,0,0"/></StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="#192638" Padding="14" CornerRadius="6" Margin="0,0,0,14">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="PERSISTED DIES" Foreground="#91A7C0" FontSize="11"/><TextBlock Text="{Binding Progress}" FontSize="25"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="SIMULATED PASS RATE" Foreground="#91A7C0" FontSize="11"/><TextBlock Text="{Binding PassRate}" FontSize="25" Foreground="#61E1C1"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="THROUGHPUT" Foreground="#91A7C0" FontSize="11"/><TextBlock Text="{Binding Throughput}" FontSize="25"/></StackPanel>
        <StackPanel Grid.Column="3"><TextBlock Text="LAST RUN STATUS" Foreground="#91A7C0" FontSize="11"/><TextBlock Text="{Binding LastStatus}" FontSize="25" Foreground="#FFB971"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource PanelBrush}" Padding="15" CornerRadius="6" Margin="0,0,12,12">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="RUN CONFIGURATION" FontWeight="SemiBold" Foreground="#91A7C0" Margin="0,0,0,12"/>
          <TextBlock Text="Recipe"/><TextBlock Text="{Binding RecipeName}" Foreground="#61E1C1" Margin="0,5,0,10" TextWrapping="Wrap"/>
          <TextBlock Text="Dataset directory"/><TextBox Text="{Binding DatasetPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Directory generated by si_generate"/>
          <Button Content="Load recipe + wafer" Command="{Binding LoadCommand}"/>
          <TextBlock Text="Lot ID"/><TextBox Text="{Binding LotId, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="Wafer ID"/><TextBox Text="{Binding WaferId, UpdateSourceTrigger=PropertyChanged}"/>
          <WrapPanel><Button Content="Start" Command="{Binding StartCommand}" Background="#257969"/><Button Content="Pause" Command="{Binding PauseCommand}"/><Button Content="Resume" Command="{Binding ResumeCommand}"/><Button Content="Stop" Command="{Binding StopCommand}"/><Button Content="Reset" Command="{Binding ResetCommand}"/></WrapPanel>
          <TextBlock Text="FAULT INJECTION" FontWeight="SemiBold" Foreground="#FFB971" Margin="0,15,0,3"/>
          <ComboBox ItemsSource="{Binding FaultKinds}" SelectedItem="{Binding SelectedFault}"/>
          <TextBlock Text="Trigger at Die index"/><TextBox Text="{Binding FaultDie, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="Configure before Start. Clear the fault, then Reset after an error." Foreground="#91A7C0" TextWrapping="Wrap" FontSize="11"/>
        </StackPanel></ScrollViewer>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource PanelBrush}" Padding="15" CornerRadius="6" Margin="0,0,12,12">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="WAFER MAP / SERPENTINE SCAN" FontWeight="SemiBold" Foreground="#91A7C0"/>
          <local:WaferView Grid.Row="1" Dies="{Binding Dies}" Results="{Binding Results}" ActiveDie="{Binding ActiveDie}" Margin="0,12"/>
          <WrapPanel Grid.Row="2"><TextBlock Text="● Pending   " Foreground="#637A9A" FontSize="11"/><TextBlock Text="● Processing   " Foreground="#74ACFF" FontSize="11"/><TextBlock Text="● Pass   " Foreground="#61E1C1" FontSize="11"/><TextBlock Text="● Fail   " Foreground="#FFB971" FontSize="11"/><TextBlock Text="● Error" Foreground="#F47191" FontSize="11"/></WrapPanel>
        </Grid>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" Padding="15" CornerRadius="6" Margin="0,0,0,12">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="DIE IMAGE / OBSERVED COORDINATES" FontWeight="SemiBold" Foreground="#91A7C0"/>
          <local:InspectionView Grid.Row="1" Bitmap="{Binding Bitmap}" Result="{Binding SelectedResult}" MeasurementRegion="{Binding MeasurementRegion}" Margin="0,12" ClipToBounds="True"/>
          <TextBlock Grid.Row="2" Text="{Binding MeasurementText}" Foreground="#61E1C1" TextWrapping="Wrap"/>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource PanelBrush}" Padding="12" CornerRadius="6" Margin="0,0,12,0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,8"><TextBlock Text="PERSISTED INSPECTION RESULTS" Foreground="#91A7C0" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="History / filter" Command="{Binding HistoryCommand}" Padding="8,3" Margin="10,0,0,0"/><Button Content="Export CSV" Command="{Binding ExportCommand}" Padding="8,3" Margin="8,0,0,0"/></StackPanel></DockPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}">
            <DataGrid.Columns><DataGridTextColumn Header="Die" Binding="{Binding Die.Index}" Width="45"/><DataGridTextColumn Header="X" Binding="{Binding Die.X}" Width="40"/><DataGridTextColumn Header="Y" Binding="{Binding Die.Y}" Width="40"/><DataGridTextColumn Header="Verdict" Binding="{Binding Inspection.Verdict}" Width="70"/><DataGridTextColumn Header="Width / μm" Binding="{Binding Inspection.WidthMicrons, StringFormat=F3}" Width="100"/><DataGridTextColumn Header="Algorithm / ms" Binding="{Binding Inspection.AlgorithmMs, StringFormat=F3}" Width="110"/><DataGridTextColumn Header="End-to-end / ms" Binding="{Binding EndToEndMs, StringFormat=F2}" Width="*"/></DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource PanelBrush}" Padding="12" CornerRadius="6"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="EVENTS &amp; ALARMS" Foreground="#FFB971" FontWeight="SemiBold" Margin="0,0,0,8"/><ListBox Grid.Row="1" ItemsSource="{Binding Events}" Background="#111B2C" Foreground="#BCD0E4" BorderThickness="0" FontSize="11"/></Grid></Border>
    </Grid>
    <TextBlock Grid.Row="4" Text="{Binding Message}" Foreground="#91A7C0" Margin="0,12,0,0" TextWrapping="Wrap"/>
  </Grid>
</Window>
