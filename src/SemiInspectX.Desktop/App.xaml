<Application x:Class="SemiInspectX.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#172031" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DCE5F5" /><Setter Property="FontSize" Value="13" /></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#26354D" /><Setter Property="Foreground" Value="#EDF7FF" />
      <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="14,9" /><Setter Property="Margin" Value="0,0,7,7" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38" /></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#0E1625" /><Setter Property="Foreground" Value="#E3EDF8" /><Setter Property="BorderBrush" Value="#33445E" /><Setter Property="Padding" Value="8" /><Setter Property="Margin" Value="0,5,0,12" /></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8" /><Setter Property="Margin" Value="0,5,0,12" /></Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#111B2C" /><Setter Property="Foreground" Value="#DCE5F5" /><Setter Property="RowBackground" Value="#172031" />
      <Setter Property="AlternatingRowBackground" Value="#1B273A" /><Setter Property="BorderThickness" Value="0" /><Setter Property="GridLinesVisibility" Value="None" />
      <Setter Property="AutoGenerateColumns" Value="False" /><Setter Property="IsReadOnly" Value="True" /><Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="CanUserAddRows" Value="False" /><Setter Property="RowHeight" Value="29" />
      <Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#28374D" /><Setter Property="Foreground" Value="#A5BAD2" /><Setter Property="Padding" Value="10,8" /></Style></Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>
